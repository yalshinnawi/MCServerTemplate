# ==============================================================================
# Create Aeronautics Server Environment Configuration
# ==============================================================================
# Host Profile: Constrained Laptop (Intel Core i7-6600U 2C/4T, 16 GB Total RAM, Windows WSL2)
#
# Memory Budget Breakdown (16 GB Total Host RAM):
#   - Windows 10/11 Host OS + System Services : ~4.0 - 5.0 GB
#   - Docker WSL2 Engine Limit (see .wslconfig) : 12.0 GB
#   - Container Maximum Memory Limit           : 11.0 GB (CONTAINER_MEM_LIMIT)
#   - Java JVM Max Heap Memory                 :  9.0 GB (MEMORY)
#   - Java Metaspace / Off-Heap / ZGC Overhead : ~2.0 GB
# ==============================================================================

# --- Remote Console (RCON) ---
# IMPORTANT: Change this to a strong, secret password before public deployment!
RCON_PASSWORD=ChangeMeSecureRconPassword!

# --- Minecraft Engine & Modloader ---
# Target version: 1.21.1 (recommended) or 1.20.1
MC_VERSION=1.21.1

# NeoForge Modloader version
# For 1.21.1: 21.1.264
# For 1.20.1: 47.1.3 (Forge / NeoForge legacy)
LOADER_VERSION=21.1.264

# --- Memory Allocation ---
# Maximum JVM Heap space (-Xmx). Must leave at least 2 GB within CONTAINER_MEM_LIMIT
# for off-heap direct buffers, thread stacks, Metaspace, and native libraries.
MEMORY=9G

# Hard container memory ceiling enforced by Docker daemon cgroups.
# Prevents memory ballooning from causing host pagefile thrashing or OS-level OOM freezes.
CONTAINER_MEM_LIMIT=11G

